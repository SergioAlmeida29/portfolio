# Copiado automaticamente pelo Vite conforme o modo:
#   npm run dev            -> .env.development (opcional) + .env
#   npm run build          -> .env.production
#   npm run build:staging  -> .env.staging
# Só variáveis com prefixo VITE_ chegam ao browser.

VITE_APP_ENV=production
VITE_SITE_URL=https://sergioalmeida.dev
